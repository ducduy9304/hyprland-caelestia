#!/bin/sh
# Clipboard history picker, like `caelestia clipboard` but images show a thumbnail in fuzzel.
# Usage: clipboard [-d]   (-d deletes the chosen entry instead of copying it)

cache="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist-thumbs"
mkdir -p "$cache"

list() {
    cliphist list | while IFS= read -r line; do
        id=${line%%	*}
        ext=$(printf '%s\n' "$line" | sed -n 's/^[0-9]*	\[\[ binary data .* \(png\|jpeg\|jpg\|gif\|webp\|bmp\) [0-9]*x[0-9]* \]\]$/\1/p')
        if [ -n "$ext" ]; then
            img="$cache/$id.$ext"
            [ -s "$img" ] || printf '%s\n' "$line" | cliphist decode > "$img"
            # fuzzel dmenu reads a per-line icon as "text\0icon\x1f<path>"
            printf '%s\0icon\037%s\n' "$line" "$img"
        else
            printf '%s\n' "$line"
        fi
    done
}

# Drop thumbnails of entries that are no longer in the history
ids=$(cliphist list | cut -f1)
for f in "$cache"/*; do
    [ -e "$f" ] || continue
    n=$(basename "$f"); n=${n%.*}
    printf '%s\n' "$ids" | grep -qx "$n" || rm -f "$f"
done

if [ "$1" = -d ]; then
    chosen=$(list | fuzzel --dmenu --prompt='del > ' --placeholder='Delete from clipboard') || exit 0
    printf '%s\n' "$chosen" | cliphist delete
else
    chosen=$(list | fuzzel --dmenu --placeholder='Type to search clipboard') || exit 0
    printf '%s\n' "$chosen" | cliphist decode | wl-copy

    # Paste into the focused window; give focus a moment to return after fuzzel closes
    sleep 0.15
    case $(hyprctl activewindow -j | jq -r .class) in
        *ptyxis*|*kitty*|*foot*|*Alacritty*|*wezterm*|*terminal*|*Terminal*) mods="CTRL SHIFT" ;;
        *) mods="CTRL" ;;
    esac
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"$mods\", key = \"V\" })" > /dev/null
fi
