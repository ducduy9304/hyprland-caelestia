#!/bin/sh
# Backend for the shell's clipboard popup (caelestia/nix/clipboard.patch, SUPER + V).
# Usage:
#   clipboard --list           print "<image path or empty>\t<cliphist line>" per entry, newest first
#   clipboard --paste <line>   copy that entry and paste it into the focused window
#   clipboard --delete <line>  remove that entry from the history

cache="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist-thumbs"
mkdir -p "$cache"

case $1 in
--list)
    # Drop images of entries that are no longer in the history
    ids=$(cliphist list | cut -f1)
    for f in "$cache"/*; do
        [ -e "$f" ] || continue
        n=$(basename "$f"); n=${n%.*}
        printf '%s\n' "$ids" | grep -qx "$n" || rm -f "$f"
    done

    cliphist list | while IFS= read -r line; do
        id=${line%%	*}
        ext=$(printf '%s\n' "$line" | sed -n 's/^[0-9]*	\[\[ binary data .* \(png\|jpeg\|jpg\|gif\|webp\|bmp\) [0-9]*x[0-9]* \]\]$/\1/p')
        img=""
        if [ -n "$ext" ]; then
            img="$cache/$id.$ext"
            [ -s "$img" ] || printf '%s\n' "$line" | cliphist decode > "$img"
        fi
        printf '%s\t%s\n' "$img" "$line"
    done
    ;;
--paste)
    printf '%s\n' "$2" | cliphist decode | wl-copy

    # Paste into the focused window; give focus a moment to return after the popup closes
    sleep 0.15
    case $(hyprctl activewindow -j | jq -r .class) in
        *ptyxis*|*kitty*|*foot*|*Alacritty*|*wezterm*|*terminal*|*Terminal*) mods="CTRL SHIFT" ;;
        *) mods="CTRL" ;;
    esac
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"$mods\", key = \"V\" })" > /dev/null
    ;;
--delete)
    printf '%s\n' "$2" | cliphist delete
    ;;
*)
    echo "usage: clipboard --list | --paste <line> | --delete <line>" >&2
    exit 1
    ;;
esac
