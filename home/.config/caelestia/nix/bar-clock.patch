diff -ruN a/components/AnalogClock.qml b/components/AnalogClock.qml
--- a/components/AnalogClock.qml
+++ b/components/AnalogClock.qml
@@ -0,0 +1,126 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Analog face drawn with rotated rectangles, so it stays cheap to redraw every second
+Item {
+    id: root
+
+    property real size: 24
+    property color faceColour: "transparent"
+    property color rimColour: handColour
+    property color tickColour: handColour
+    property color handColour
+    property color secondColour: handColour
+    property color numberColour: handColour
+    property bool showSeconds
+    property bool showTicks: size >= 64
+    property bool showNumbers
+    readonly property real rimWidth: faceColour.a > 0 ? 0 : Math.max(1.5, size * 0.07)
+
+    implicitWidth: size
+    implicitHeight: size
+
+    component Hand: Rectangle {
+        id: hand
+
+        property real length
+        property real angle
+
+        x: root.size / 2 - width / 2
+        y: root.size / 2 - length
+        height: length
+        radius: width / 2
+        antialiasing: true
+
+        transform: Rotation {
+            origin.x: hand.width / 2
+            origin.y: hand.length
+            angle: hand.angle
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        radius: width / 2
+        color: root.faceColour
+        border.color: root.rimColour
+        border.width: root.rimWidth
+        antialiasing: true
+    }
+
+    Repeater {
+        model: root.showTicks ? 12 : 0
+
+        Rectangle {
+            id: tick
+
+            required property int index
+            readonly property real inset: root.rimWidth > 0 ? root.rimWidth + 1.5 : root.size * 0.06
+
+            visible: root.size >= 64 || index % 3 === 0
+            x: root.size / 2 - width / 2
+            y: inset
+            width: Math.max(1.5, index % 3 === 0 ? root.size * 0.03 : root.size * 0.015)
+            height: Math.max(2, (index % 3 === 0 && !root.showNumbers ? 0.09 : 0.05) * root.size)
+            radius: width / 2
+            color: root.tickColour
+            antialiasing: true
+
+            transform: Rotation {
+                origin.x: tick.width / 2
+                origin.y: root.size / 2 - tick.inset
+                angle: tick.index * 30
+            }
+        }
+    }
+
+    Repeater {
+        model: root.showNumbers ? 12 : 0
+
+        StyledText {
+            id: number
+
+            required property int index
+            readonly property real angle: (index + 1) * Math.PI / 6
+            readonly property real radius: root.size * 0.33
+
+            x: root.size / 2 + radius * Math.sin(angle) - width / 2
+            y: root.size / 2 - radius * Math.cos(angle) - height / 2
+            text: index + 1
+            color: root.numberColour
+            font: Tokens.font.clock.size(root.size * 0.07).weight(Font.DemiBold).build()
+        }
+    }
+
+    Hand {
+        width: Math.max(1.5, root.size * 0.05)
+        length: root.size * (root.showNumbers ? 0.22 : 0.26)
+        angle: (Time.hours % 12) * 30 + Time.minutes / 2
+        color: root.handColour
+    }
+
+    Hand {
+        width: Math.max(1.2, root.size * 0.035)
+        length: root.size * 0.38
+        angle: Time.minutes * 6 + (root.showSeconds ? Time.seconds / 10 : 0)
+        color: root.handColour
+    }
+
+    Hand {
+        visible: root.showSeconds
+        width: Math.max(1, root.size * 0.012)
+        length: root.size * 0.42
+        angle: Time.seconds * 6
+        color: root.secondColour
+    }
+
+    Rectangle {
+        anchors.centerIn: parent
+        width: Math.max(2.5, root.size * 0.07)
+        height: width
+        radius: width / 2
+        color: root.showSeconds ? root.secondColour : root.handColour
+    }
+}
