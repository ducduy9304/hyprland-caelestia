diff -ruN a/modules/bar/popouts/ClockPopout.qml b/modules/bar/popouts/ClockPopout.qml
--- a/modules/bar/popouts/ClockPopout.qml
+++ b/modules/bar/popouts/ClockPopout.qml
@@ -0,0 +1,45 @@
+import QtQuick
+import QtQuick.Layouts
+import Caelestia.Config
+import qs.components
+import qs.services
+import "../../dashboard/dash"
+
+// Analog clock and month calendar, reusing the dashboard's own pieces
+RowLayout {
+    spacing: Tokens.spacing.medium
+
+    StyledRect {
+        Layout.preferredWidth: calendar.implicitHeight
+        Layout.preferredHeight: calendar.implicitHeight
+
+        radius: Tokens.rounding.extraLarge
+        color: Colours.tPalette.m3surfaceContainer
+
+        AnalogClock {
+            anchors.centerIn: parent
+            size: parent.height - Tokens.padding.large * 2
+            faceColour: Colours.palette.m3surfaceContainerHigh
+            tickColour: Colours.palette.m3onSurfaceVariant
+            handColour: Colours.palette.m3secondary
+            secondColour: Colours.palette.m3primary
+            numberColour: Colours.palette.m3onSurface
+            showSeconds: true
+            showNumbers: true
+        }
+    }
+
+    StyledRect {
+        Layout.preferredWidth: 320
+        Layout.preferredHeight: calendar.implicitHeight
+
+        radius: Tokens.rounding.extraLarge
+        color: Colours.tPalette.m3surfaceContainer
+
+        Calendar {
+            id: calendar
+
+            screenState: ShellState.forActive()
+        }
+    }
+}
