diff -ruN a/modules/nexus/pages/bluetooth/BluetoothPairing.qml b/modules/nexus/pages/bluetooth/BluetoothPairing.qml
--- a/modules/nexus/pages/bluetooth/BluetoothPairing.qml
+++ b/modules/nexus/pages/bluetooth/BluetoothPairing.qml
